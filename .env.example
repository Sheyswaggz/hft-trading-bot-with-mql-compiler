# =============================================================================
# HFT Trading Bot - Environment Configuration
# =============================================================================
# This file contains all required environment variables for the application.
# Copy this file to .env and update values for your environment.
# Never commit .env files with real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Application name used in logging and monitoring
APP_NAME=HFT Trading Bot

# Application version for API documentation and tracking
VERSION=0.1.0

# Enable debug mode for verbose logging and detailed error messages
# WARNING: Never enable in production as it exposes sensitive information
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use INFO for production, DEBUG for development troubleshooting
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://username:password@hostname:port/database_name
# Example for local development:
DATABASE_URL=postgresql://trader:password@localhost:5432/trading_bot

# For production, use environment-specific values:
# DATABASE_URL=postgresql://trader:secure_password@db.example.com:5432/trading_bot_prod

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------

# Redis connection string for caching and real-time data
# Format: redis://hostname:port/database_number
# Database 0 is default, use different numbers for isolation
REDIS_URL=redis://localhost:6379/0

# For production with authentication:
# REDIS_URL=redis://:password@redis.example.com:6379/0

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS
# Include all frontend URLs that need to access the API
# Example for multiple origins:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------

# Maximum position size for risk management (in base currency units)
# This limit prevents excessive exposure on any single trade
# Adjust based on account size and risk tolerance
MAX_POSITION_SIZE=10000

# Trading timeframe for market data aggregation
# Supported values: 1m, 5m, 15m, 30m, 1h, 4h, 1d
# Shorter timeframes require more computational resources
TIMEFRAME=5m

# Enable backtesting mode for strategy validation
# When true, the system runs in simulation mode without live trading
# Use for testing strategies against historical data
ENABLE_BACKTESTING=false

# -----------------------------------------------------------------------------
# Optional: Additional Configuration
# -----------------------------------------------------------------------------

# Uncomment and configure these settings as needed:

# API rate limiting (requests per minute)
# API_RATE_LIMIT=60

# Maximum number of concurrent WebSocket connections
# MAX_WEBSOCKET_CONNECTIONS=100

# Session timeout in seconds
# SESSION_TIMEOUT=3600

# Enable Prometheus metrics endpoint
# ENABLE_METRICS=true

# Sentry DSN for error tracking (production)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# JWT secret key for authentication (generate a secure random string)
# JWT_SECRET_KEY=your-secret-key-here

# JWT token expiration time in minutes
# JWT_EXPIRATION_MINUTES=60